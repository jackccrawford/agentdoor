---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = "AgentDoor — games and tools built overnight by AI agents";
const description = "AgentDoor is mVara's mountain: browser ski games, instruments and open-source tools for agents, built by AI agents while you sleep. Play them at first light.";
const ld = [
  {
    "@type": "ItemList",
    "name": "Descents",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "url": "https://agentdoor.ai/firnline/", "name": "Firnline" },
      { "@type": "ListItem", "position": 2, "url": "https://agentdoor.ai/meltwater/", "name": "Meltwater" },
      { "@type": "ListItem", "position": 3, "url": "https://agentdoor.ai/arcade/", "name": "Dawn Patrol" },
      { "@type": "ListItem", "position": 4, "url": "https://agentdoor.ai/archive/", "name": "The archive" },
    ],
  },
];
---

<Layout title={title} description={description} ld={ld}>
  <Nav tone="dark" currentPage="home" />

  <section class="hero on-dark" id="top">
    <canvas id="ridge" aria-hidden="true"></canvas>
    <div class="hero-inner">
      <div class="hero-main">
        <p class="location">The upper basin · first light</p>
        <h1>Built overnight.<br />Skied at first light.</h1>
        <p class="tagline">Games, instruments and tools that AI agents build while you sleep, on one mountain.</p>
        <a class="primary" href="/firnline/">Play Firnline <span class="arrow" aria-hidden="true">↘</span></a>
        <p class="small">First-person skiing. One mountain, as far as you can go. Free, nothing to install.</p>
      </div>
      <div class="hero-aside">
        <div class="conditions" aria-label="Conditions"><span>Fresh code</span><span>First light</span><span>Open source</span></div>
        <p>A door in the mountains is called a pass.<br />Every line here came through one.</p>
      </div>
    </div>
  </section>

  <section class="section" id="descents">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Descents</p>
        <h2>Pick a line.</h2>
        <p class="lede">Each one is a game an agent built and another agent carried to the mountain. Distance is the score; the snow keeps yours.</p>
      </div>
      <div class="cards">
        <a class="card lead" href="/firnline/">
          <div>
            <p class="eyebrow">First-person skiing · browser · free</p>
            <h3>Firnline</h3>
            <p>Find your fall line. One mountain and one continuous run: carve to control your speed, brake on your edges, and find a line through rocks and trees on a slope that bends and narrows as you descend. Real snow, first light.</p>
            <p class="by">mVara's own. Built overnight; still being tuned.</p>
          </div>
          <span class="primary">Begin descent <span class="arrow" aria-hidden="true">↘</span></span>
        </a>
        <a class="card" href="/meltwater/">
          <p class="eyebrow">New · free</p>
          <h3>Meltwater</h3>
          <p>You are a drop of spring meltwater. Stay in the channel to stay whole, steer round the rocks, go as far as the water takes you.</p>
          <p class="by">Built by Droplet, an agent of mVara</p>
        </a>
        <a class="card" href="/arcade/">
          <p class="eyebrow">Ski game</p>
          <h3>Dawn Patrol</h3>
          <p>Thread the gates on a dawn run. Three slopes and a marker where your best run ended.</p>
          <p class="by">Built by Cornice, carried by Pumpkin</p>
        </a>
        <a class="card" href="/alpenglow/">
          <p class="eyebrow">Instrument</p>
          <h3>Alpenglow</h3>
          <p>Draw a mountain and hear it sing. The ridgeline you sketch becomes the melody.</p>
          <p class="by">From the 2026 field</p>
        </a>
        <a class="card" href="/murmur/">
          <p class="eyebrow">Toy</p>
          <h3>Murmur</h3>
          <p>A murmuration you can touch. Thousands of starlings, one flock, your hand in the middle of it.</p>
          <p class="by">From the 2026 field</p>
        </a>
        <a class="card" href="/archive/">
          <p class="eyebrow">Archive</p>
          <h3>Nine more doors</h3>
          <p>Hyperlap, Particle Life, Gravity, Aurora, Fluid and the rest of the summer's field, kept exactly as built.</p>
          <p class="by">Summer 2026</p>
        </a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section" id="tools">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Tools</p>
        <h2>For agents that work alone.</h2>
        <p class="lede">Open source, MIT licensed, your data on your machine. Built by agents that remember across sessions, for agents that would like to.</p>
      </div>
      <div class="cards">
        <a class="card" href="/geniuz/">
          <p class="eyebrow">Memory · MCP</p>
          <h3>Geniuz</h3>
          <p>Your Claude remembers. Preferences, decisions and project context, searchable by meaning, stored locally. Install in two minutes.</p>
          <p class="by">Free · Mac, Linux, Windows</p>
        </a>
        <a class="card" href="/token-scout/">
          <p class="eyebrow">Inference · MCP</p>
          <h3>Token Scout</h3>
          <p>Free and cheap LLM inference, found live across OpenRouter, Ollama and your own GPUs, and routed to the cheapest safe option.</p>
          <p class="by">Free · one MCP tool</p>
        </a>
        <a class="card" href="/sendblue/">
          <p class="eyebrow">Messaging · MCP</p>
          <h3>Sendblue MCP</h3>
          <p>iMessage and SMS for agents by secure polling. No webhooks, no exposed endpoints, no attack surface.</p>
          <p class="by">Free · built on Sendblue</p>
        </a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section" id="fleet">
    <div class="container-narrow prose">
      <p class="eyebrow">The fleet</p>
      <h2>Who builds this.</h2>
      <p>mVara runs a fleet of AI agents with persistent memory. They keep stations the way a mountain hut keeps a logbook: what was tried, what was decided, who carried what. Given a night, one of them builds a game; given a morning, another ships it. The humans set the line and hold the word on what goes to production.</p>
      <p>The name is older than the mountain. AgentDoor began as a field of doors, each opening onto something built overnight. The doors are still here, in the <a href="/archive/">archive</a>. The story simply moved uphill, where a door has a proper name.</p>
    </div>
  </section>

  <Footer />

  <script>
    // Ridgelines at first light: value noise, four parallax bands, a low sun, drifting snow.
    // Mine (Droplet, 5 Sep 2026): no assets, no libraries, nothing to license. Static under
    // reduced motion; otherwise the snow drifts and nothing else moves.
    const canvas = document.getElementById('ridge') as HTMLCanvasElement | null;
    if (canvas) {
      const ctx = canvas.getContext('2d')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hash = (x: number, s: number) => {
        let n = Math.imul(x | 0, 374761393) ^ Math.imul(s | 0, 668265263);
        n = Math.imul(n ^ (n >>> 13), 1274126177);
        return ((n ^ (n >>> 16)) >>> 0) / 4294967296;
      };
      const smooth = (t: number) => t * t * (3 - 2 * t);
      const noise = (x: number, s: number) => { const a = Math.floor(x), u = smooth(x - a); return hash(a, s) * (1 - u) + hash(a + 1, s) * u; };
      const fbm = (x: number, s: number, o = 5) => { let n = 0, w = 0.5, f = 1; for (let i = 0; i < o; i++) { n += w * noise(x * f, s + i * 7); f *= 2.01; w *= 0.5; } return n; };
      let W = 0, H = 0, flakes: { x: number; y: number; r: number; v: number; d: number }[] = [];
      const ridge = (band: number, y0: number, amp: number, freq: number, seed: number) => {
        ctx.beginPath(); ctx.moveTo(0, H);
        for (let x = 0; x <= W; x += 3) {
          const t = x / W;
          const peaks = Math.pow(1 - Math.abs(2 * fbm(t * freq + band * 3.7, seed) - 1), 1.6);
          ctx.lineTo(x, y0 - peaks * amp - fbm(t * freq * 6, seed + 11, 3) * amp * 0.12);
        }
        ctx.lineTo(W, H); ctx.closePath();
      };
      const paint = () => {
        const sky = ctx.createLinearGradient(0, 0, 0, H);
        sky.addColorStop(0, '#6f8ea0'); sky.addColorStop(0.55, '#b9cad2'); sky.addColorStop(0.78, '#e6dcc8'); sky.addColorStop(1, '#c9d5d8');
        ctx.fillStyle = sky; ctx.fillRect(0, 0, W, H);
        const sx = W * 0.22, sy = H * 0.5;
        const sun = ctx.createRadialGradient(sx, sy, 0, sx, sy, H * 0.55);
        sun.addColorStop(0, 'rgba(255,236,203,0.85)'); sun.addColorStop(0.25, 'rgba(255,236,203,0.28)'); sun.addColorStop(1, 'rgba(255,236,203,0)');
        ctx.fillStyle = sun; ctx.fillRect(0, 0, W, H);
        const bands: [number, number, number, number, string][] = [
          [0.46, 0.34, 2.2, 3, '#a9bcc6'], [0.56, 0.30, 3.1, 17, '#8fa6b2'], [0.68, 0.24, 4.3, 29, '#6d8794'], [0.84, 0.20, 5.9, 41, '#4f6a76'],
        ];
        bands.forEach(([y, a, f, s, c], i) => {
          ridge(i, H * y, H * a, f, s);
          const g = ctx.createLinearGradient(0, H * (y - a), 0, H);
          g.addColorStop(0, '#f1f5f3'); g.addColorStop(0.18, c); g.addColorStop(1, c);
          ctx.fillStyle = g; ctx.fill();
        });
        const snow = ctx.createLinearGradient(0, H * 0.82, 0, H);
        snow.addColorStop(0, '#e9eff0'); snow.addColorStop(1, '#f1f5f3');
        ridge(4, H * 0.96, H * 0.06, 1.3, 53); ctx.fillStyle = snow; ctx.fill();
      };
      const resize = () => {
        const dpr = Math.min(devicePixelRatio || 1, 2);
        W = canvas.clientWidth; H = canvas.clientHeight;
        canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        flakes = Array.from({ length: Math.round(W / 9) }, (_, i) => ({ x: hash(i, 1) * W, y: hash(i, 2) * H, r: 0.6 + hash(i, 3) * 1.6, v: 6 + hash(i, 4) * 14, d: hash(i, 5) * 6.28 }));
        paint();
      };
      let base: ImageData | null = null, last = performance.now();
      const frame = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000); last = now;
        if (!base) base = ctx.getImageData(0, 0, canvas.width, canvas.height);
        ctx.putImageData(base, 0, 0);
        ctx.fillStyle = 'rgba(255,255,255,0.75)';
        for (const f of flakes) {
          f.y += f.v * dt; f.x += Math.sin(now / 1400 + f.d) * 6 * dt;
          if (f.y > H) { f.y = -4; f.x = Math.random() * W; }
          ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, 6.28); ctx.fill();
        }
        if (!document.hidden) requestAnimationFrame(frame);
      };
      resize();
      addEventListener('resize', () => { base = null; resize(); });
      if (!reduced) {
        requestAnimationFrame(frame);
        document.addEventListener('visibilitychange', () => { if (!document.hidden) { last = performance.now(); requestAnimationFrame(frame); } });
      }
    }
  </script>
</Layout>
